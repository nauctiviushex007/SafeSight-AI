DATABASE_URL=sqlite:///./safesight.db
# Rules engine thresholds
MIN_PERSON_CONF=0.50
MIN_PPE_CONF=0.40
MIN_PERSON_HEIGHT_PX=80
# Vision
YOLO_MODEL_PATH=models/ppe.pt
YOLO_CONF=0.35
VIDEO_SAMPLE_EVERY=15
